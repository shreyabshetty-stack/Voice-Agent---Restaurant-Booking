# Server Configuration
PORT=3000

# Speech-to-Text (STT) - Deepgram API
DEEPGRAM_API_KEY=your_deepgram_api_key

# Orchestration / LLM - Groq API
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Text-to-Speech (TTS) - Smallest AI Waves
SMALLEST_AI_API_KEY=your_smallest_ai_api_key

# Gemini Live (Phase 2 Real-time)
GEMINI_API_KEY=your_gemini_api_key

# Google Sheets & Google Calendar MCP Integration
# Option A: Local service_account.json file path
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Option B: Cloud deployment (paste entire service account JSON string)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_CALENDAR_ID=your_google_calendar_id
